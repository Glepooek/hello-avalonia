<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:Avalonia.Shared.Controls"
             x:Class="Avalonia.StarterTutorialDemo.Views.Pages.ExercisesPage">

    <StackPanel Margin="12" Spacing="12">
        <shared:DemoHeader Title="练习：三个练习的完成版"
                           DocPath="docs/get-started/starter-tutorial/exercises" />

        <TextBlock TextWrapping="Wrap">
            <Run Text="① ShowGridLines=False（隐藏网格线）  ② 华氏框 IsReadOnly=True（禁止输入）  ③ 用 TextChanged 实时换算，不再需要按钮。" />
        </TextBlock>

        <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="12">
            <!--  Exercise 1: gridlines off.  -->
            <Grid ShowGridLines="False" Margin="5" HorizontalAlignment="Center"
                  ColumnDefinitions="120,100" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Center">Celsius</TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center">Fahrenheit</TextBlock>
                <!--  Exercise 3: convert while typing.  -->
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0 5" Text="0"
                         Name="Celsius" TextChanged="Celsius_TextChanged" />
                <!--  Exercise 2: the user cannot type here.  -->
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0 5" Text="32.0"
                         Name="Fahrenheit" IsReadOnly="True" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
