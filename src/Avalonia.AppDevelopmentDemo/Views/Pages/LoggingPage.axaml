<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="using:Avalonia.Shared.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560"
             x:Class="Avalonia.AppDevelopmentDemo.Views.Pages.LoggingPage">

    <ScrollViewer>
        <StackPanel Margin="12">
            <shared:DemoHeader Title="日志：在应用启动阶段统一配置"
                               DocPath="app-development/logging-errors-and-warnings" />

            <TextBlock Classes="caption" Text="应用日志（Microsoft.Extensions.Logging）" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="ApplicationServices：注册 ILoggerProvider 与 AddLogging。" TextWrapping="Wrap" />
                    <TextBlock Text="MainWindow、ApplicationExceptionReporter：通过构造函数获得 ILogger。" TextWrapping="Wrap" />
                    <TextBlock Text="所有应用日志共用同一个 Provider，不随页面切换而更换。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="caption" Text="Avalonia 框架日志" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Program.BuildAvaloniaApp：通过 LogToTrace(LogEventLevel.Debug) 接入调试输出。" TextWrapping="Wrap" />
                    <TextBlock Text="绑定、布局和样式等框架消息由 Avalonia.Logger 产生，与 ILogger 是两条独立管线。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="日志属于应用基础设施，应在启动时配置一次。页面只说明两套日志的职责，不再创建 LoggerFactory，也不再替换进程级 Logger.Sink。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
