<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="using:Avalonia.Shared.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560"
             x:Class="Avalonia.AppDevelopmentDemo.Views.Pages.UnhandledExceptionsPage">

    <ScrollViewer>
        <StackPanel Margin="12">
            <shared:DemoHeader Title="未处理异常：按应用生命周期统一接入"
                               DocPath="app-development/setting-unhandled-exceptions" />

            <TextBlock Classes="caption" Text="Program.Main：进程级最后防线" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="全局 try/catch：记录越过桌面生命周期入口的致命异常，并设置非零退出码。" TextWrapping="Wrap" />
                    <TextBlock Text="AppDomain.CurrentDomain.UnhandledException：记录未处理的域异常。" TextWrapping="Wrap" />
                    <TextBlock Text="TaskScheduler.UnobservedTaskException：记录未观察的 Task 异常并调用 SetObserved。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="caption" Text="App.OnFrameworkInitializationCompleted：UI 线程" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="订阅 Dispatcher.UIThread.UnhandledException，并交给 ApplicationExceptionReporter 记录。" TextWrapping="Wrap" />
                    <TextBlock Text="应用退出时解除订阅并释放 DI 容器。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="记录异常不代表应用可以安全继续运行。本项目不会对未知 UI 异常设置 Handled = true；只有在业务明确证明状态仍然有效时，才应选择继续。页面本身不订阅全局事件，也不主动制造崩溃。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
