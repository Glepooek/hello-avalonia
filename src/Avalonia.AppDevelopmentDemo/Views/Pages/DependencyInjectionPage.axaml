<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="using:Avalonia.Shared.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560"
             x:Class="Avalonia.AppDevelopmentDemo.Views.Pages.DependencyInjectionPage">

    <ScrollViewer>
        <StackPanel Margin="12">
            <shared:DemoHeader Title="依赖注入：在应用组合根中注册和解析"
                               DocPath="app-development/dependency-injection" />

            <TextBlock Classes="caption" Text="实现位置" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="ApplicationServices.CreateServiceProvider：集中注册应用服务。" TextWrapping="Wrap" />
                    <TextBlock Text="App.OnFrameworkInitializationCompleted：创建根容器并解析 MainWindow。" TextWrapping="Wrap" />
                    <TextBlock Text="App 退出时释放 ServiceProvider，服务生命周期与应用生命周期一致。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="caption" Text="本项目中的注册" />
            <Border Classes="stage" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="IClock → SystemClock：Singleton" />
                    <TextBlock Text="Greeter、MainWindow：Transient" />
                    <TextBlock Text="Counter：用 keyed service 演示 Transient / Scoped / Singleton" TextWrapping="Wrap" />
                    <TextBlock Text="ILogger 与 ApplicationExceptionReporter：由同一个应用容器提供" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="页面不创建容器，也不解析服务。MainWindow 的 Greeter 与 ILogger 通过构造函数注入；容器启用 ValidateOnBuild 和 ValidateScopes，让无效注册与错误的 Scoped 解析尽早失败。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
