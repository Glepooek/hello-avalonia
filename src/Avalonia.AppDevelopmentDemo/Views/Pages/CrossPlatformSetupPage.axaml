<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="using:Avalonia.Shared.Controls"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560"
             x:Class="Avalonia.AppDevelopmentDemo.Views.Pages.CrossPlatformSetupPage">

    <ScrollViewer>
        <StackPanel Margin="12">
            <shared:DemoHeader Title="跨平台解决方案结构：共享核心与平台启动项目"
                               DocPath="app-development/cross-platform-solution-setup" />
            <TextBlock TextWrapping="Wrap"
                       Text="共享核心项目承载 UI、ViewModel 与跨平台服务，各平台项目只负责启动和平台集成。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
