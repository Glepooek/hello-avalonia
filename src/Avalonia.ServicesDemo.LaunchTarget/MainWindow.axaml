<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalonia.ServicesDemo.LaunchTarget.MainWindow"
        Title="程序 2（LaunchTarget）"
        Width="480"
        Height="360"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16" Spacing="8">
        <TextBlock FontSize="18" Text="我是程序 2，由程序 1 用 Process.Start 启动" />
        <TextBlock Name="PidText" />
        <TextBlock Text="收到的命令行参数（每行一个）：" />
        <Border Padding="8" BorderBrush="Gray" BorderThickness="1">
            <ItemsControl Name="ArgsList" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown Name="ExitCodeBox" Width="140" Minimum="0" Maximum="255" Value="0" FormatString="0" />
            <Button Name="ExitButton"
                    AutomationProperties.AutomationId="ExitButton"
                    Content="以此退出码退出"
                    Click="OnExit" />
        </StackPanel>
    </StackPanel>
</Window>
